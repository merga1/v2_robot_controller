# Environment Configuration for Restaurant Delivery Robot Platform
# Copy to .env for local overrides

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./robot_restaurant.db
JWT_SECRET=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MQTT Broker Settings
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_KEEP_ALIVE=60

# Raspberry Pi 5 Gateway Settings
ROBOT_ID=robot_pi5_01
TABLES_CONFIG_PATH=mqtt_contract/tables.yaml
LOCAL_MISSION_CACHE=local_mission_state.json
TELEOP_TIMEOUT_SEC=0.5
CONFIRMATION_TIMEOUT_SEC=90.0

# Mobile App Target Defaults
DEFAULT_BACKEND_URL=http://192.168.1.100:8000
